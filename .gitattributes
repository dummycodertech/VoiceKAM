# Normalize text files to LF in the Git repository while preserving binary assets
* text=auto eol=lf

*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
LICENSE text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.zip binary
*.exe binary
