# =============================================================================
# VoiceKAM - Environment Configuration
# Copy this file to .env and add your free-tier API keys. Never commit .env!
# =============================================================================

# Primary LLM: Groq Free Tier (https://console.groq.com/keys)
# Note: llama-4-scout was retired 17 Jul 2026; chain verified at startup via /models.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.6-27b,qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=low

# Fallback 1 LLM: Google Gemini Free Tier via AI Studio (https://aistudio.google.com/apikey)
# Note: gemini-3.8-flash excluded (~20 RPD free cap). Cooldown applied on 429.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Fallback 2 LLM (Optional): OpenRouter Free Tier (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Provider Cooldown on HTTP 429 (seconds)
PROVIDER_COOLDOWN_SECONDS=60

# STT Fallback (Optional, for non-Chrome browsers via Groq Whisper)
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# TTS Configuration: auto | edge-tts | gemini-tts | browser
TTS_PROVIDER=auto
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
# Emergency Gemini TTS fallback chain (tested at startup; newest passing free model preferred)
GEMINI_TTS_MODELS=gemini-3.8-flash-tts,gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Aoede
TTS_CACHE_ENABLED=true

# Server & Runtime Settings
PORT=7860
LLM_TIMEOUT_SECONDS=12.0
ENABLE_GEMINI_LIVE=false
